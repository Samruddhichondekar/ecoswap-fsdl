# ==========================================
# EcoSwap Backend Cloud Environment Configuration
# ==========================================

# Application Port (Render automatically sets PORT in production)
PORT=5050
NODE_ENV=development

# Database as a Service (DBaaS) - MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas cluster credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecoswap?retryWrites=true&w=majority

# Identity & Access Management (IAM) - JWT Secret Key
JWT_SECRET=ecoswap_super_secret_jwt_key_2024

# Platform as a Service (PaaS) - Frontend Client URL for CORS
# Comma-separated list of allowed origins (e.g. local dev + Vercel deployment)
CLIENT_URL=http://localhost:5173,https://ecoswap.vercel.app

# Storage as a Service (STaaS) - AWS S3 Cloud Storage Credentials
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=ecoswap-product-images
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

